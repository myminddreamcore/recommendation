<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="768"
        x:Class="RecommendationsAvalonia.Main"
        Title="RecommendationsAvalonia"
        Background="#FAF8F5"
        MinWidth="1366" MinHeight="768">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FAF8F5" BorderBrush="#D4C5B0" BorderThickness="0,0,1,0">
            <StackPanel Margin="24,32,24,0" Spacing="0">
                
                <TextBlock Text="ИТ-Проф" 
                           FontSize="18" 
                           FontWeight="Normal"
                           Foreground="#8B2C1D"
                           Margin="0,0,0,32"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Главная" 
                               FontSize="14" 
                               Foreground="#8B2C1D"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Поиск" 
                               PointerPressed="TextBlock_PointerPressed"
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Подборки" 
                               PointerPressed="TextBlock_PointerPressed_1"
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                   
                </StackPanel>

                <Button Click="Button_Click" 
                        Content="Обновить"
                        Background="White"
                        BorderBrush="#D4C5B0"
                        BorderThickness="1"
                        Foreground="#5C4D3E"
                        Padding="16,10"
                        Margin="0,32,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Margin="0,0,0,0">
            <StackPanel Margin="32,32,32,32" Spacing="24">
                
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="16">
                    <TextBlock Grid.Column="0" Text="Фото" FontSize="13" Foreground="#5C4D3E" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="fio" FontSize="14" Foreground="#4A3B2C" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Name="role" FontSize="13" Foreground="#8B7A6B" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Column="3" Width="140" Background="White" BorderBrush="#D4C5B0" BorderThickness="1" Padding="8,6">
                        <ComboBoxItem Foreground="#5C4D3E">Мой профиль</ComboBoxItem>
                        <ComboBoxItem Foreground="#5C4D3E">Настройки</ComboBoxItem>
                        <ComboBoxItem Foreground="#5C4D3E">Выбор</ComboBoxItem>
                    </ComboBox>
                    <Button  Click="Button_Click1" Grid.Column="4" Content="Выход" Background="White" BorderBrush="#D4C5B0" BorderThickness="1" Foreground="#8B2C1D" Padding="16,6"/>
                </Grid>

                <Border Height="1" Background="#D4C5B0"/>

                <Grid ColumnDefinitions="1*, 1*" ColumnSpacing="32">
                    
                    <Border Grid.Column="0" Background="#FAF8F5" BorderBrush="#D4C5B0" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Сводка по активности" FontSize="14" FontWeight="Normal" Foreground="#4A3B2C"/>
                            <Border Height="1" Background="#D4C5B0"/>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Профили" FontSize="12" Foreground="#8B7A6B"/>
                                    <TextBlock Name="profil" FontSize="28" Foreground="#8B2C1D"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Вакансии" FontSize="12" Foreground="#8B7A6B"/>
                                    <TextBlock Name="vacancy" FontSize="28" Foreground="#8B2C1D"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Рейтинг" FontSize="12" Foreground="#8B7A6B"/>
                                    <TextBlock Name="rating" FontSize="28" Foreground="#8B2C1D"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FAF8F5" BorderBrush="#D4C5B0" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Топ-5 технологий" FontSize="14" FontWeight="Normal" Foreground="#4A3B2C"/>
                            <Border Height="1" Background="#D4C5B0"/>
                            <TextBlock FontSize="28" Foreground="#8B2C1D" Name="skills">
                                
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>