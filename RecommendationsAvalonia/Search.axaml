<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="768"
        x:Class="RecommendationsAvalonia.Search"
        Title="RecommendationsAvalonia"
        Background="#FAF8F5"
        MinWidth="1366" MinHeight="768">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FAF8F5" BorderBrush="#D4C5B0" BorderThickness="0,0,1,0">
            <StackPanel Margin="24,32,24,0" Spacing="0">
                
                <TextBlock Text="ИТ-Проф" 
                           FontSize="18" 
                           FontWeight="Normal"
                           Foreground="#8B2C1D"
                           Margin="0,0,0,32"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Главная" 
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Поиск" 
                               FontSize="14" 
                               Foreground="#8B2C1D"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Подборки" 
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                    <!-- <TextBlock Text="Отчеты" 
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Аналитика" 
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/>
                    <TextBlock Text="Администрирование" 
                               FontSize="14" 
                               Foreground="#5C4D3E"
                               Padding="0,10,0,10"/> -->
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Margin="0,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="32,32,32,32" Spacing="24">
                    
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Text="Фото" FontSize="13" Foreground="#5C4D3E" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Name="fio" FontSize="14" Foreground="#4A3B2C" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Name="role" FontSize="13" Foreground="#8B7A6B" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" Width="140" Background="White" BorderBrush="#D4C5B0" BorderThickness="1" Padding="8,6">
                            <ComboBoxItem Foreground="#5C4D3E">Мой профиль</ComboBoxItem>
                            <ComboBoxItem Foreground="#5C4D3E">Настройки</ComboBoxItem>
                            <ComboBoxItem Foreground="#5C4D3E">Выбор</ComboBoxItem>
                        </ComboBox>
                        <Button Grid.Column="4" Content="Выход" Background="White" BorderBrush="#D4C5B0" BorderThickness="1" Foreground="#8B2C1D" Padding="16,6"/>
                    </Grid>

                    <Border Height="1" Background="#D4C5B0"/>

                    <TextBlock Text="Поиск кандидатов" FontSize="20" FontWeight="Normal" Foreground="#4A3B2C"/>

                    <Border Background="#FAF8F5" BorderBrush="#D4C5B0" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="16">
                            
                            <StackPanel Spacing="8">
                                <TextBlock Text="Технологии" FontSize="13" Foreground="#5C4D3E"/>
                                <TextBlock Name="skillname" FontSize="12" Foreground="#8B7A6B" Margin="0,0,0,4"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <TextBox Name="skillsn" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                    <Button Click="Button_Click_4" 
                                            Content="Автодополнить"
                                            Grid.Column="1"
                                            Background="White"
                                            BorderBrush="#D4C5B0"
                                            BorderThickness="1"
                                            Foreground="#5C4D3E"
                                            Padding="12,8"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Уровень (от - до)" FontSize="13" Foreground="#5C4D3E"/>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <TextBox Name="urovenot" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                    <TextBox Name="urovendo" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Опыт (лет)" FontSize="13" Foreground="#5C4D3E"/>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <TextBox Name="opytot" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                    <TextBox Name="opytdo" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Рейтинг" FontSize="13" Foreground="#5C4D3E"/>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <TextBox Name="ratingot" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                    <TextBox Name="ratingdo" 
                                             Background="White"
                                             BorderBrush="#D4C5B0"
                                             BorderThickness="1"
                                             Padding="10,8"
                                             FontSize="13"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Click="Button_Click" 
                                        Content="Найти"
                                        Background="#8B2C1D"
                                        BorderThickness="0"
                                        Foreground="White"
                                        Padding="20,8"/>
                                <Button Click="Button_Click_1" 
                                        Content="Очистить"
                                        Background="White"
                                        BorderBrush="#D4C5B0"
                                        BorderThickness="1"
                                        Foreground="#5C4D3E"
                                        Padding="20,8"/>
                               
                                <Button Click="Button_Click_3" 
                                        Content="CSV"
                                        Background="White"
                                        BorderBrush="#D4C5B0"
                                        BorderThickness="1"
                                        Foreground="#5C4D3E"
                                        Padding="20,8"/>
                                <ComboBox Name="cb" 
                                          SelectionChanged="cb_SelectionChanged"
                                          Width="80"
                                          Background="White"
                                          BorderBrush="#D4C5B0"
                                          BorderThickness="1"
                                          Padding="8,6">
                                    <ComboBoxItem Foreground="#5C4D3E">25</ComboBoxItem>    
                                    <ComboBoxItem Foreground="#5C4D3E">50</ComboBoxItem>    
                                    <ComboBoxItem Foreground="#5C4D3E">100</ComboBoxItem>    
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Name="dg" 
                              Sorting="MyDataGrid_Sorting"
                              Background="White"
                              BorderBrush="#D4C5B0"
                              BorderThickness="1"
                              HeadersVisibility="Column"
                              RowBackground="White"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E8DFD4"
                              VerticalGridLinesBrush="Transparent"
                              Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" 
                                                SortMemberPath="Id"
                                                Binding="{Binding Id}" 
                                                Width="80"
                                                Foreground="#5C4D3E"/>
                            <DataGridTextColumn Header="Кандидат" 
                                                SortMemberPath="Name"
                                                Binding="{Binding Name}" 
                                                Width="*"
                                                Foreground="#5C4D3E"/>
                            <DataGridTextColumn Header="Навыки" 
                                                SortMemberPath="Skills"
                                                Binding="{Binding Skills}" 
                                                Width="*"
                                                Foreground="#5C4D3E"/>
                            <DataGridTextColumn Header="Рейтинг" 
                                                SortMemberPath="Rating"
                                                Binding="{Binding Rating}" 
                                                Width="100"
                                                Foreground="#5C4D3E"/>
                        </DataGrid.Columns>        
                    </DataGrid>

                    <StackPanel Orientation="Horizontal">
                        <Button Click="Button_Click_7" 
                                Content="Подробно"
                                Background="White"
                                BorderBrush="#D4C5B0"
                                BorderThickness="1"
                                Foreground="#5C4D3E"
                                Padding="20,8"/>
                        <Button Click="Button_Click_5" 
                                Content="+"
                                Background="White"
                                BorderBrush="#D4C5B0"
                                BorderThickness="1"
                                Foreground="#5C4D3E"
                                Padding="20,8"/>
                        <Button Click="Button_Click_6" 
                                Content="-"
                                Background="White"
                                BorderBrush="#D4C5B0"
                                BorderThickness="1"
                                Foreground="#8B2C1D"
                                Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>